#include <windows.h>
#include <commctrl.h>
#include "adjustments_resource.h"
#include "launcher_version.h"
#include "launcher_resource.h"

IDI_LAUNCHER ICON "launcher.ico"
IDI_UPDATE_RECOVERY ICON "launcher-recovery.ico"
IDW_NO_ACTION_DING WAVE "no-action-ding.wav"
IDR_UPDATER_BOOTSTRAP RCDATA "UpdaterBootstrap.ps1"

#include "pending_overlay.rc"

1 RT_MANIFEST "launcher.generated.manifest"

IDD_ADJUSTMENTS DIALOGEX 0, 0, 270, 244
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_CONTROLPARENT
CAPTION "Launcher adjustments"
FONT 9, "Segoe UI", 400, 0, 1
BEGIN
    LTEXT "Changes are previewed immediately. Apply or OK saves them.", -1, 9, 8, 252, 20
    LTEXT "Text scale (%)", -1, 12, 35, 120, 12
    EDITTEXT IDC_TEXT_SCALE, 170, 32, 78, 15, ES_AUTOHSCROLL | ES_RIGHT | WS_TABSTOP
    CONTROL "", IDC_TEXT_SPIN, UPDOWN_CLASS, UDS_ALIGNRIGHT | UDS_ARROWKEYS | UDS_NOTHOUSANDS, 238, 32, 10, 15
    LTEXT "Icon/panel scale (%)", -1, 12, 58, 120, 12
    EDITTEXT IDC_ICON_SCALE, 170, 55, 78, 15, ES_AUTOHSCROLL | ES_RIGHT | WS_TABSTOP
    CONTROL "", IDC_ICON_SPIN, UPDOWN_CLASS, UDS_ALIGNRIGHT | UDS_ARROWKEYS | UDS_NOTHOUSANDS, 238, 55, 10, 15
    LTEXT "Icon spacing (px)", -1, 12, 81, 120, 12
    EDITTEXT IDC_ICON_SPACING, 170, 78, 78, 15, ES_AUTOHSCROLL | ES_RIGHT | WS_TABSTOP
    CONTROL "", IDC_SPACING_SPIN, UPDOWN_CLASS, UDS_ALIGNRIGHT | UDS_ARROWKEYS | UDS_NOTHOUSANDS, 238, 78, 10, 15
    LTEXT "Page thickness (DIP)", -1, 12, 104, 120, 12
    EDITTEXT IDC_THICKNESS, 170, 101, 78, 15, ES_AUTOHSCROLL | ES_RIGHT | WS_TABSTOP
    CONTROL "", IDC_THICKNESS_SPIN, UPDOWN_CLASS, UDS_ALIGNRIGHT | UDS_ARROWKEYS | UDS_NOTHOUSANDS, 238, 101, 10, 15
    LTEXT "", IDC_EFFECTIVE_SIZES, 12, 126, 182, 64
    CONTROL "", IDC_PRESET_LIST, "LISTBOX", WS_CHILD | WS_BORDER | WS_VSCROLL | WS_TABSTOP | LBS_NOTIFY | LBS_NOINTEGRALHEIGHT, 12, 126, 182, 64
    PUSHBUTTON "&Store...", IDC_STORE_PRESET, 204, 126, 54, 14
    PUSHBUTTON "&Recall...", IDC_RECALL_PRESET, 204, 149, 54, 14
    LTEXT "", IDC_ADJUSTMENT_STATUS, 12, 195, 246, 19
    PUSHBUTTON "Reset sizes", IDC_RESET_SIZES, 9, 222, 66, 14
    PUSHBUTTON "Apply", IDC_APPLY_ADJUSTMENTS, 88, 222, 52, 14
    DEFPUSHBUTTON "OK", IDOK, 147, 222, 52, 14
    PUSHBUTTON "Cancel", IDCANCEL, 206, 222, 55, 14
END

IDD_ABOUT DIALOGEX 0, 0, 340, 180
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_CONTROLPARENT
CAPTION "About Launcher"
FONT 9, "Segoe UI", 400, 0, 1
BEGIN
    ICON IDI_LAUNCHER, -1, 12, 12, 24, 24
    LTEXT "", IDC_ABOUT_VERSION, 48, 12, 280, 14
    LTEXT "", IDC_ABOUT_STATUS, 48, 29, 280, 18, SS_NOPREFIX
    EDITTEXT IDC_ABOUT_DETAILS, 12, 53, 316, 80, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL | WS_TABSTOP
    LTEXT "", IDC_ABOUT_UPDATE_STATUS, 12, 138, 316, 12
    PUSHBUTTON "Check now", IDC_ABOUT_CHECK_NOW, 12, 155, 76, 14
    PUSHBUTTON "Copy details", IDC_ABOUT_COPY, 186, 155, 76, 14
    DEFPUSHBUTTON "OK", IDOK, 272, 155, 56, 14
END

VS_VERSION_INFO VERSIONINFO
FILEVERSION LAUNCHER_VERSION_RESOURCE
PRODUCTVERSION LAUNCHER_PRODUCT_VERSION_RESOURCE
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
#define LAUNCHER_DEBUG_FLAG VS_FF_DEBUG
#else
#define LAUNCHER_DEBUG_FLAG 0
#endif
#if LAUNCHER_PRERELEASE
#define LAUNCHER_PRERELEASE_FLAG VS_FF_PRERELEASE
#else
#define LAUNCHER_PRERELEASE_FLAG 0
#endif
#if LAUNCHER_BUILD_SPECIAL
#define LAUNCHER_SPECIAL_FLAG VS_FF_SPECIALBUILD
#else
#define LAUNCHER_SPECIAL_FLAG 0
#endif
FILEFLAGS LAUNCHER_DEBUG_FLAG | LAUNCHER_PRERELEASE_FLAG | LAUNCHER_SPECIAL_FLAG
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Launcher\0"
            VALUE "FileVersion", LAUNCHER_VERSION_RESOURCE_STRING
            VALUE "InternalName", "Launcher\0"
            VALUE "LegalCopyright", LAUNCHER_COPYRIGHT_RESOURCE
            VALUE "OriginalFilename", "Launcher.exe\0"
            VALUE "ProductName", LAUNCHER_PRODUCT_NAME_RESOURCE
            VALUE "ProductVersion", LAUNCHER_PRODUCT_VERSION_RESOURCE_STRING
            VALUE "BuildDateTime", LAUNCHER_BUILD_BUILT
            VALUE "BuildConfiguration", LAUNCHER_BUILD_BUILD_CONFIGURATION
            VALUE "CommitId", LAUNCHER_BUILD_COMMIT
            VALUE "GitVersion", LAUNCHER_BUILD_GIT_VERSION
            VALUE "SourceState", LAUNCHER_BUILD_SOURCE_STATE
            VALUE "ReleaseStatus", LAUNCHER_RELEASE_STATUS
            VALUE "Comments", LAUNCHER_DISTRIBUTION_COMMENT
            VALUE "DistributionKind", LAUNCHER_DISTRIBUTION_KIND
            VALUE "SpecialBuild", LAUNCHER_BUILD_INSTRUMENTATION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
