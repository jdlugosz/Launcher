cmake_minimum_required(VERSION 3.25)

string(RANDOM LENGTH 12 run)
set(TEST_ROOT "${TEST_ROOT}/${run}")
file(MAKE_DIRECTORY "${TEST_ROOT}")
function(git_command)
    execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${TEST_ROOT}" ${ARGN}
        RESULT_VARIABLE result OUTPUT_QUIET ERROR_VARIABLE error)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Git fixture failed: ${error}")
    endif()
endfunction()
git_command(init --quiet)
git_command(config user.name "Launcher test")
git_command(config user.email "test@example.invalid")
file(WRITE "${TEST_ROOT}/source.txt" "first\n")
file(MAKE_DIRECTORY "${TEST_ROOT}/licenses")
file(WRITE "${TEST_ROOT}/licenses/Prerelease.txt" "prerelease fixture terms\n")
file(WRITE "${TEST_ROOT}/licenses/Release.txt" "final release fixture terms\n")
file(WRITE "${TEST_ROOT}/CMakeLists.txt" "project(Launcher VERSION 1.6.0 LANGUAGES NONE)\n")
file(WRITE "${TEST_ROOT}/vcpkg.json" "{\"version-semver\":\"1.6.0\"}\n")
git_command(add source.txt licenses CMakeLists.txt vcpkg.json)
git_command(commit --quiet -m first)

include("${LICENSE_SELECTOR}")
launcher_distribution_license("${TEST_ROOT}" "1.7.0" Prerelease)
if(NOT LAUNCHER_LICENSE_FILE STREQUAL "${TEST_ROOT}/licenses/Prerelease.txt" OR
        NOT LAUNCHER_LICENSE_NOTICE MATCHES "Prerelease evaluation only")
    message(FATAL_ERROR "Default distribution did not select prerelease terms.")
endif()
launcher_distribution_license("${TEST_ROOT}" "1.6.1" Special)
if(NOT LAUNCHER_LICENSE_FILE STREQUAL "${TEST_ROOT}/licenses/Prerelease.txt")
    message(FATAL_ERROR "Special distribution did not select evaluation terms.")
endif()
launcher_distribution_license("${TEST_ROOT}" "1.7.0" Beta)
if(NOT LAUNCHER_LICENSE_FILE STREQUAL "${TEST_ROOT}/licenses/Release.txt" OR
        NOT LAUNCHER_LICENSE_NOTICE MATCHES "Public Beta")
    message(FATAL_ERROR "Beta distribution did not select community terms on the development series.")
endif()
launcher_distribution_license("${TEST_ROOT}" "1.6.0" Release)
if(NOT LAUNCHER_LICENSE_FILE STREQUAL "${TEST_ROOT}/licenses/Release.txt" OR
        NOT LAUNCHER_LICENSE_NOTICE MATCHES "Public release")
    message(FATAL_ERROR "Explicit release distribution did not select release terms.")
endif()

function(check_release expected version)
    execute_process(COMMAND "${CMAKE_COMMAND}" "-DSOURCE_DIR=${TEST_ROOT}"
        "-DRELEASE_VERSION=${version}" "-DGIT_EXECUTABLE=${GIT_EXECUTABLE}"
        -P "${RELEASE_CHECK}" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(expected STREQUAL "success")
        if(NOT result EQUAL 0)
            message(FATAL_ERROR "Release fixture should be accepted: ${output}${error}")
        endif()
    elseif(result EQUAL 0 OR NOT "${output}${error}" MATCHES "${expected}")
        message(FATAL_ERROR "Expected release rejection '${expected}': ${output}${error}")
    endif()
endfunction()

check_release("trusted signed version tag" "1.6.0")
check_release("even minor version" "1.7.0")
file(WRITE "${TEST_ROOT}/licenses/Release.txt" "DRAFT - NOT ADOPTED\n")
check_release("still a draft" "1.6.0")
execute_process(COMMAND "${CMAKE_COMMAND}" "-DSOURCE_DIR=${TEST_ROOT}" "-DDISTRIBUTION_KIND=Beta"
    -P "${LICENSE_SELECTOR}" RESULT_VARIABLE beta_result OUTPUT_QUIET ERROR_VARIABLE beta_error)
if(beta_result EQUAL 0 OR NOT beta_error MATCHES "still a draft")
    message(FATAL_ERROR "Expected Beta distribution to reject a draft license: ${beta_error}")
endif()
file(WRITE "${TEST_ROOT}/licenses/Release.txt" "final release fixture terms\n")

function(generate expected_state expected_special flags label git)
    execute_process(COMMAND "${CMAKE_COMMAND}"
        "-DSOURCE_DIR=${TEST_ROOT}" "-DOUTPUT=${OUTPUT}" "-DGIT_EXECUTABLE=${git}"
        "-DBUILD_CONFIGURATION=Release" "-DBUILD_FLAGS=${flags}" "-DBUILD_INSTRUMENTATION=${label}"
        "-DRELEASE_VERSION=${ARGN}"
        -P "${GENERATOR}" RESULT_VARIABLE result)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Build metadata generation failed")
    endif()
    file(READ "${OUTPUT}" header)
    if(NOT header MATCHES "LAUNCHER_BUILD_SOURCE_STATE \"${expected_state}" OR
            NOT header MATCHES "LAUNCHER_BUILD_SPECIAL ${expected_special}")
        message(FATAL_ERROR "Incorrect build provenance: ${header}")
    endif()
    set(last_header "${header}" PARENT_SCOPE)
endfunction()

function(expect_git_version expected)
    string(FIND "${last_header}" "#define LAUNCHER_BUILD_GIT_VERSION \"${expected}\\0\"" found)
    if(found EQUAL -1)
        message(FATAL_ERROR "Expected Git version '${expected}': ${last_header}")
    endif()
endfunction()

generate(Clean 0 "" "" "${GIT_EXECUTABLE}")
set(first_header "${last_header}")
execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${TEST_ROOT}" rev-parse --short=8 HEAD
    OUTPUT_VARIABLE first_short OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
expect_git_version("${first_short}")
# Checkpoints are not release labels. Tags may be added without a source edit.
git_command(tag archive/checkpoint)
generate(Clean 0 "" "" "${GIT_EXECUTABLE}")
expect_git_version("${first_short}")
git_command(tag -a v1.2 -m release)
generate(Clean 0 "" "" "${GIT_EXECUTABLE}")
expect_git_version("${first_short}")
file(APPEND "${TEST_ROOT}/source.txt" "second\n")
generate("Modified working tree" 1 "/fsanitize=address /PROFILE" "Code coverage" "${GIT_EXECUTABLE}")
expect_git_version("${first_short}+")
if(NOT last_header MATCHES "Code coverage, AddressSanitizer, Profiling enabled")
    message(FATAL_ERROR "Instrumentation flags were lost: ${last_header}")
endif()
git_command(add source.txt)
git_command(commit --quiet -m second)
generate(Clean 0 "" "" "${GIT_EXECUTABLE}")
string(REGEX MATCH "LAUNCHER_BUILD_COMMIT [^\n]+" first_commit "${first_header}")
string(REGEX MATCH "LAUNCHER_BUILD_COMMIT [^\n]+" second_commit "${last_header}")
if(first_commit STREQUAL second_commit)
    message(FATAL_ERROR "Commit stamp was not refreshed after a commit")
endif()
execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${TEST_ROOT}" rev-parse --short=8 HEAD
    OUTPUT_VARIABLE second_short OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
# An ancestor's v1.2 label must not identify this newer commit as that release.
expect_git_version("${second_short}")
git_command(tag v1.4)
generate(Clean 0 "" "" "${GIT_EXECUTABLE}")
expect_git_version("${second_short}")
# Use a disposable SSH signing identity, never the developer's private key.
get_filename_component(git_directory "${GIT_EXECUTABLE}" DIRECTORY)
find_program(ssh_keygen NAMES ssh-keygen.exe ssh-keygen
    HINTS "$ENV{SystemRoot}/System32/OpenSSH" "${git_directory}/../usr/bin" REQUIRED)
set(signing "${TEST_ROOT}-signing")
file(MAKE_DIRECTORY "${signing}")
execute_process(COMMAND "${ssh_keygen}" -q -t ed25519 -N "" -C release@example.invalid -f "${signing}/key"
    COMMAND_ERROR_IS_FATAL ANY)
file(READ "${signing}/key.pub" public_key)
file(WRITE "${signing}/allowed_signers" "release@example.invalid ${public_key}")
git_command(config gpg.format ssh)
git_command(config gpg.ssh.program "${ssh_keygen}")
git_command(config gpg.ssh.allowedSignersFile "${signing}/allowed_signers")
git_command(config user.signingkey "${signing}/key")
git_command(tag -s v1.6 -m "signed release fixture")
check_release(success "1.6.0")
check_release("does not match the configured release version" "1.8.0")
git_command(tag v9.8 v1.6)
check_release("does not match the configured release version" "9.8.0")
git_command(tag -d v9.8)
git_command(tag -s v9.8 -m "other version on the same fixture commit")
generate(Clean 0 "" "" "${GIT_EXECUTABLE}" "1.6.0")
expect_git_version("v1.6 (${second_short})")
generate(Clean 0 "" "" "${GIT_EXECUTABLE}" "1.8.0")
expect_git_version("${second_short}")
git_command(tag -d v9.8)
generate(Clean 0 "" "" "${GIT_EXECUTABLE}")
expect_git_version("v1.6 (${second_short})")

# Another exact unsigned tag must not mask a trusted signed release.
git_command(tag -a v0.0 -m "ephemeral unsigned tag")
generate(Clean 0 "" "" "${GIT_EXECUTABLE}")
expect_git_version("v1.6 (${second_short})")

# A valid signature by a key outside the trusted release signer set is ignored.
file(WRITE "${signing}/allowed_signers" "")
check_release("trusted signed version tag" "1.6.0")
generate(Clean 0 "" "" "${GIT_EXECUTABLE}")
expect_git_version("${second_short}")
file(WRITE "${signing}/allowed_signers" "release@example.invalid ${public_key}")

# Ref names are unsigned. Reusing a signed object under a different version
# name cannot turn that alias into an official release.
git_command(tag v9.9 v1.6)
git_command(tag -d v1.6)
check_release("trusted signed version tag" "1.6.0")
generate(Clean 0 "" "" "${GIT_EXECUTABLE}")
expect_git_version("${second_short}")
git_command(tag v1.6 v9.9)
file(WRITE "${TEST_ROOT}/untracked.txt" "uncommitted\n")
check_release("clean Git working tree" "1.6.0")
generate("Modified working tree" 0 "" "" "${GIT_EXECUTABLE}")
expect_git_version("v1.6 (${second_short}+)")
git_command(add --all)
git_command(commit --quiet -m third)
check_release("trusted signed version tag" "1.6.0")
execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${TEST_ROOT}" rev-parse --short=8 HEAD
    OUTPUT_VARIABLE third_short OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
generate(Clean 0 "" "" "${GIT_EXECUTABLE}")
expect_git_version("${third_short}")
generate(Unavailable 0 "" "" "")
expect_git_version("Unavailable")
if(NOT last_header MATCHES "Unavailable \\(Git metadata absent\\)")
    message(FATAL_ERROR "Source archive was attributed to an invented commit")
endif()
