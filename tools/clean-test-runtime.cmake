cmake_minimum_required(VERSION 3.25)

if(NOT DEFINED SOURCE_DIR OR NOT IS_ABSOLUTE "${SOURCE_DIR}" OR
        NOT DEFINED BINARY_DIR OR NOT IS_ABSOLUTE "${BINARY_DIR}")
    message(FATAL_ERROR "SOURCE_DIR and BINARY_DIR must be explicit absolute directories.")
endif()
if(IS_SYMLINK "${SOURCE_DIR}" OR IS_SYMLINK "${BINARY_DIR}")
    message(FATAL_ERROR "Cleanup roots must be real directories, not directory links.")
endif()

# Runtime files are generated settings, not source fixtures. Preserve any future
# tracked exceptions in a checkout; extracted source trees do not require Git.
if(EXISTS "${SOURCE_DIR}/.git")
    find_program(cleanup_git NAMES git REQUIRED)
endif()

function(clean_runtime_directory directory recurse source_files)
    if(NOT IS_DIRECTORY "${directory}" OR IS_SYMLINK "${directory}")
        return()
    endif()
    file(GLOB entries LIST_DIRECTORIES true "${directory}/*")
    foreach(path IN LISTS entries)
        if(IS_SYMLINK "${path}")
            continue()
        endif()
        string(TOLOWER "${path}" lowercase_path)
        if(IS_DIRECTORY "${path}")
            if(recurse)
                clean_runtime_directory("${path}" TRUE "${source_files}")
            endif()
        elseif(lowercase_path MATCHES "\\.runtime\\.toml$")
            if(source_files AND cleanup_git)
                file(RELATIVE_PATH relative_path "${SOURCE_DIR}" "${path}")
                execute_process(COMMAND "${cleanup_git}" --literal-pathspecs -C "${SOURCE_DIR}" ls-files --error-unmatch -- "${relative_path}"
                    RESULT_VARIABLE tracked_result OUTPUT_QUIET ERROR_VARIABLE tracked_error)
                if(tracked_result STREQUAL "0")
                    continue()
                elseif(NOT tracked_result STREQUAL "1")
                    message(FATAL_ERROR "Cannot check tracked runtime fixture '${path}': ${tracked_error}")
                endif()
            endif()
            file(REMOVE "${path}")
            if(EXISTS "${path}")
                message(FATAL_ERROR "Cannot remove generated runtime settings: ${path}")
            endif()
            set_property(GLOBAL APPEND PROPERTY removed_runtime_files "${path}")
        endif()
    endforeach()
endfunction()

clean_runtime_directory("${SOURCE_DIR}" FALSE TRUE)
foreach(directory IN ITEMS examples tests)
    clean_runtime_directory("${SOURCE_DIR}/${directory}" TRUE TRUE)
endforeach()
clean_runtime_directory("${BINARY_DIR}" FALSE FALSE)
clean_runtime_directory("${BINARY_DIR}/examples" TRUE FALSE)
foreach(configuration IN ITEMS Debug Release RelWithDebInfo)
    if(NOT IS_SYMLINK "${BINARY_DIR}/${configuration}")
        clean_runtime_directory("${BINARY_DIR}/${configuration}" FALSE FALSE)
        clean_runtime_directory("${BINARY_DIR}/${configuration}/examples" TRUE FALSE)
    endif()
endforeach()
foreach(directory IN ITEMS install-layout-tests display-edge-tests)
    clean_runtime_directory("${BINARY_DIR}/${directory}" TRUE FALSE)
endforeach()
get_property(removed_runtime_files GLOBAL PROPERTY removed_runtime_files)
list(LENGTH removed_runtime_files removed_count)
message(STATUS "Removed ${removed_count} generated test runtime settings file(s).")
