cmake_minimum_required(VERSION 3.25)

function(launcher_distribution_license source version distribution_kind)
    if(distribution_kind STREQUAL "Release")
        if(NOT version MATCHES "^[0-9]+\\.([0-9]+)\\.[0-9]+$")
            message(FATAL_ERROR "Release packaging requires a three-part project version.")
        endif()
        math(EXPR odd_minor "${CMAKE_MATCH_1} % 2")
        if(odd_minor)
            message(FATAL_ERROR "Release packaging requires an even minor version; ${version} is development.")
        endif()
    endif()
    if(distribution_kind MATCHES "^(Beta|Release)$")
        set(license_file "${source}/licenses/Release.txt")
        if(NOT EXISTS "${license_file}")
            message(FATAL_ERROR "Release license is missing: ${license_file}")
        endif()
        file(READ "${license_file}" license_text)
        if(license_text MATCHES "DRAFT|NOT ADOPTED|NON-OPERATIVE|NO LICENSE GRANTED")
            message(FATAL_ERROR "Release license is still a draft. Finalize and adopt licenses/Release.txt before Beta or Release packaging.")
        endif()
        if(distribution_kind STREQUAL "Beta")
            set(license_notice "Public Beta. See LICENSE.txt for the community license and commercial licensing terms.")
        else()
            set(license_notice "Public release. See LICENSE.txt for the community license and commercial licensing terms.")
        endif()
    elseif(distribution_kind MATCHES "^(Prerelease|Special)$")
        set(license_file "${source}/licenses/Prerelease.txt")
        set(license_notice "Prerelease evaluation only. Do not share or redistribute this copy.\nSee LICENSE.txt for the permitted local evaluation copies and full terms.")
    else()
        message(FATAL_ERROR "Unknown distribution kind: ${distribution_kind}")
    endif()
    if(NOT EXISTS "${license_file}")
        message(FATAL_ERROR "Distribution license is missing: ${license_file}")
    endif()
    file(SIZE "${license_file}" license_size)
    if(license_size EQUAL 0)
        message(FATAL_ERROR "Distribution license is empty: ${license_file}")
    endif()
    set(LAUNCHER_LICENSE_FILE "${license_file}" PARENT_SCOPE)
    set(LAUNCHER_LICENSE_NOTICE "${license_notice}" PARENT_SCOPE)
endfunction()

if(CMAKE_SCRIPT_MODE_FILE STREQUAL CMAKE_CURRENT_LIST_FILE)
    launcher_distribution_license("${SOURCE_DIR}" "${SOURCE_VERSION}" "${DISTRIBUTION_KIND}")
endif()
