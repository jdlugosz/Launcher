#include <windows.h>
#include "launcher_version.h"

101 ICON "drop.ico"
102 ICON "launcher.ico"
1 RT_MANIFEST "drop.generated.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION LAUNCHER_VERSION_RESOURCE
PRODUCTVERSION LAUNCHER_PRODUCT_VERSION_RESOURCE
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
#define DROP_DEBUG_FLAG VS_FF_DEBUG
#else
#define DROP_DEBUG_FLAG 0
#endif
#if LAUNCHER_PRERELEASE
#define DROP_PRERELEASE_FLAG VS_FF_PRERELEASE
#else
#define DROP_PRERELEASE_FLAG 0
#endif
#if LAUNCHER_BUILD_SPECIAL
#define DROP_SPECIAL_FLAG VS_FF_SPECIALBUILD
#else
#define DROP_SPECIAL_FLAG 0
#endif
FILEFLAGS DROP_DEBUG_FLAG | DROP_PRERELEASE_FLAG | DROP_SPECIAL_FLAG
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Launcher Drop\0"
            VALUE "FileVersion", LAUNCHER_VERSION_RESOURCE_STRING
            VALUE "InternalName", "LauncherDrop\0"
            VALUE "LegalCopyright", LAUNCHER_COPYRIGHT_RESOURCE
            VALUE "OriginalFilename", "LauncherDrop.exe\0"
            VALUE "ProductName", LAUNCHER_PRODUCT_NAME_RESOURCE
            VALUE "ProductVersion", LAUNCHER_PRODUCT_VERSION_RESOURCE_STRING
            VALUE "BuildConfiguration", LAUNCHER_BUILD_BUILD_CONFIGURATION
            VALUE "ReleaseStatus", LAUNCHER_RELEASE_STATUS
            VALUE "Comments", LAUNCHER_DISTRIBUTION_COMMENT
            VALUE "DistributionKind", LAUNCHER_DISTRIBUTION_KIND
            VALUE "SpecialBuild", LAUNCHER_BUILD_INSTRUMENTATION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
