cmake_minimum_required(VERSION 3.25)

set(commit "Unavailable (Git metadata absent)")
set(source_state "Unavailable")
set(git_version "Unavailable")
if(GIT_EXECUTABLE AND EXISTS "${GIT_EXECUTABLE}")
    execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${SOURCE_DIR}" rev-parse --verify HEAD
        OUTPUT_VARIABLE revision OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET RESULT_VARIABLE result)
    if(result EQUAL 0 AND revision MATCHES "^[0-9a-f]+$")
        set(commit "${revision}")
        execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${SOURCE_DIR}" status --porcelain --untracked-files=normal
            OUTPUT_VARIABLE changes OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET RESULT_VARIABLE result)
        if(NOT result EQUAL 0)
            set(source_state "Unavailable")
        elseif(changes STREQUAL "")
            set(source_state "Clean")
        else()
            set(source_state "Modified working tree")
        endif()
        execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${SOURCE_DIR}" rev-parse --short=8 HEAD
            OUTPUT_VARIABLE short_commit OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET RESULT_VARIABLE result)
        if(NOT result EQUAL 0)
            string(SUBSTRING "${commit}" 0 8 short_commit)
        endif()
        if(source_state STREQUAL "Modified working tree")
            string(APPEND short_commit "+")
        elseif(source_state STREQUAL "Unavailable")
            string(APPEND short_commit "?")
        endif()
        # A local tag name alone never establishes a release. Verify the signed
        # tag object and its name, using Git's configured trusted signing keys.
        # Check all exact candidates so an unsigned tag cannot hide a signed one.
        set(release_tag "")
        execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${SOURCE_DIR}" for-each-ref
            "--format=%(objectname) %(refname:strip=2) %(tag)" --sort=-taggerdate --points-at=HEAD "refs/tags/v[0-9]*"
            OUTPUT_VARIABLE candidates OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET RESULT_VARIABLE result)
        if(result EQUAL 0)
            string(REPLACE "\n" ";" candidates "${candidates}")
            foreach(candidate IN LISTS candidates)
                # Lightweight tags have no embedded tag name. Also reject an
                # alias whose ref name differs from the cryptographically signed name.
                if(NOT candidate MATCHES "^([0-9a-f]+) ([^ ]+) ([^ ]+)$")
                    continue()
                endif()
                set(tag_object "${CMAKE_MATCH_1}")
                set(tag_ref "${CMAKE_MATCH_2}")
                set(tag_name "${CMAKE_MATCH_3}")
                if(NOT tag_ref STREQUAL tag_name)
                    continue()
                endif()
                if(RELEASE_VERSION)
                    string(REGEX REPLACE "\\.0$" "" release_display "${RELEASE_VERSION}")
                    if(NOT tag_name STREQUAL "v${release_display}" AND NOT tag_name STREQUAL "v${RELEASE_VERSION}")
                        continue()
                    endif()
                endif()
                execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${SOURCE_DIR}" -c gpg.minTrustLevel=fully verify-tag "${tag_object}"
                    OUTPUT_QUIET ERROR_QUIET RESULT_VARIABLE verified TIMEOUT 5)
                if(verified EQUAL 0)
                    set(release_tag "${tag_name}")
                    break()
                endif()
            endforeach()
        endif()
        if(NOT release_tag STREQUAL "")
            set(git_version "${release_tag} (${short_commit})")
        else()
            set(git_version "${short_commit}")
        endif()
    endif()
endif()

set(instrumentation "${BUILD_INSTRUMENTATION}")
string(TOLOWER "${BUILD_FLAGS}" flags)
if(flags MATCHES "[-/]fsanitize[=:]address")
    list(APPEND instrumentation "AddressSanitizer")
endif()
if(flags MATCHES "[-/]profile([ ;]|$)")
    list(APPEND instrumentation "Profiling enabled")
endif()
if(flags MATCHES "[-/]fastgenprofile|[-/]genprofile|--coverage|-fprofile-instr-generate")
    list(APPEND instrumentation "Coverage/profile instrumentation")
endif()
list(REMOVE_DUPLICATES instrumentation)
list(JOIN instrumentation ", " instrumentation)
if(instrumentation STREQUAL "")
    set(special 0)
else()
    set(special 1)
endif()

string(TIMESTAMP built "%Y-%m-%d %H:%M:%S UTC" UTC)
set(header "// Generated at build time; included only by the version resource.\n")
foreach(field IN ITEMS commit git_version source_state built instrumentation BUILD_CONFIGURATION)
    string(REPLACE "\\" "\\\\" escaped "${${field}}")
    string(REPLACE "\"" "\\\"" escaped "${escaped}")
    string(REPLACE "\n" "\\n" escaped "${escaped}")
    string(REPLACE "\r" "" escaped "${escaped}")
    string(TOUPPER "${field}" macro)
    string(APPEND header "#define LAUNCHER_BUILD_${macro} \"${escaped}\\0\"\n")
endforeach()
string(APPEND header "#define LAUNCHER_BUILD_SPECIAL ${special}\n")
get_filename_component(directory "${OUTPUT}" DIRECTORY)
file(MAKE_DIRECTORY "${directory}")
file(WRITE "${OUTPUT}.tmp" "${header}")
configure_file("${OUTPUT}.tmp" "${OUTPUT}" COPYONLY)
file(REMOVE "${OUTPUT}.tmp")
