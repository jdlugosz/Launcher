set(header "")
foreach(path IN LISTS INPUTS BINARIES)
    cmake_path(GET path FILENAME name)
    if(name STREQUAL "Launcher.exe")
        set(name "${LAUNCHER_NAME}")
    endif()
    file(SHA256 "${path}" hash)
    string(APPEND header "    {L\"${name}\", L\"${hash}\"},\n")
endforeach()
get_filename_component(directory "${OUTPUT}" DIRECTORY)
file(MAKE_DIRECTORY "${directory}")
file(CONFIGURE OUTPUT "${OUTPUT}" CONTENT "${header}" @ONLY NEWLINE_STYLE LF)
