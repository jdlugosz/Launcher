cmake_minimum_required(VERSION 3.25)

include("${CMAKE_CURRENT_LIST_DIR}/distribution-license.cmake")
launcher_distribution_license("${SOURCE_DIR}" "${RELEASE_VERSION}" Release)
if(NOT GIT_EXECUTABLE OR NOT EXISTS "${GIT_EXECUTABLE}")
    message(FATAL_ERROR "Release packaging requires Git and its trusted release signer configuration.")
endif()
file(READ "${SOURCE_DIR}/CMakeLists.txt" project_text)
if(NOT project_text MATCHES "project\\(Launcher[ \t\r\n]+VERSION[ \t\r\n]+([0-9]+\\.[0-9]+\\.[0-9]+)")
    message(FATAL_ERROR "Cannot read the source project's release version.")
endif()
if(NOT CMAKE_MATCH_1 STREQUAL RELEASE_VERSION)
    message(FATAL_ERROR "Source project version does not match the configured release version.")
endif()
file(READ "${SOURCE_DIR}/vcpkg.json" manifest)
string(JSON manifest_version GET "${manifest}" version-semver)
if(NOT manifest_version STREQUAL RELEASE_VERSION)
    message(FATAL_ERROR "vcpkg's project version must match the release version.")
endif()
execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${SOURCE_DIR}" status --porcelain --untracked-files=normal
    RESULT_VARIABLE result OUTPUT_VARIABLE changes OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
if(NOT result EQUAL 0 OR NOT changes STREQUAL "")
    message(FATAL_ERROR "Release packaging requires a clean Git working tree, including untracked files.")
endif()
execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${SOURCE_DIR}" rev-parse --verify HEAD
    RESULT_VARIABLE result OUTPUT_VARIABLE head OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Release packaging requires a committed source revision.")
endif()

set(display_version "${RELEASE_VERSION}")
string(REGEX REPLACE "\\.0$" "" display_version "${display_version}")
set(tags "v${display_version}" "v${RELEASE_VERSION}")
list(REMOVE_DUPLICATES tags)
foreach(tag IN LISTS tags)
    execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${SOURCE_DIR}" for-each-ref
        "--format=%(objectname) %(refname:strip=2) %(tag)" "refs/tags/${tag}"
        RESULT_VARIABLE result OUTPUT_VARIABLE candidate OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    if(NOT result EQUAL 0 OR NOT candidate MATCHES "^([0-9a-f]+) ([^ ]+) ([^ ]+)$")
        continue()
    endif()
    set(object "${CMAKE_MATCH_1}")
    set(ref_name "${CMAKE_MATCH_2}")
    set(signed_name "${CMAKE_MATCH_3}")
    if(NOT ref_name STREQUAL tag OR NOT signed_name STREQUAL tag)
        continue()
    endif()
    execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${SOURCE_DIR}" rev-parse "${object}^{commit}"
        RESULT_VARIABLE result OUTPUT_VARIABLE tagged_commit OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    if(NOT result EQUAL 0 OR NOT tagged_commit STREQUAL head)
        continue()
    endif()
    execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${SOURCE_DIR}" -c gpg.minTrustLevel=fully verify-tag "${object}"
        RESULT_VARIABLE result OUTPUT_QUIET ERROR_QUIET TIMEOUT 5)
    if(result EQUAL 0)
        message(STATUS "Release ${RELEASE_VERSION} verified: ${tag} at ${head}")
        return()
    endif()
endforeach()
message(FATAL_ERROR "Release packaging requires an exact trusted signed version tag on HEAD (${tags}).")
